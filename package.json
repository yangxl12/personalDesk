{
  "name": "buxu",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "engines": {
    "node": ">=22.17.0"
  },
  "packageManager": "npm@11.16.0",
  "scripts": {
    "dev": "vite dev",
    "dev:lan": "vite dev --host 0.0.0.0 --port 6173 --strictPort",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "build": "vite build && node scripts/copy-entry.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "preview:static": "vite preview",
    "test": "vitest run"
  },
  "dependencies": {
    "@ai-sdk/deepseek": "3.0.86",
    "@ai-sdk/openai-compatible": "3.0.92",
    "ai": "7.0.171",
    "dexie": "4.4.7",
    "dompurify": "3.4.18",
    "highlight.js": "11.12.0",
    "marked": "18.2.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "4.0.1",
    "@sveltejs/kit": "3.2.0",
    "@sveltejs/vite-plugin-svelte": "7.0.0",
    "@types/node": "24",
    "fake-indexeddb": "^6.2.8",
    "svelte": "5.57.3",
    "svelte-check": "^4.3.0",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
